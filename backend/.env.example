# =========================================================
# Application
# =========================================================

PORT=4000
NODE_ENV=development

# Local frontend URL.
# In production, replace this with the real HTTPS website URL.
FRONTEND_URL=http://127.0.0.1:5500

# Browser origins allowed to access the backend API.
# Separate multiple origins using commas.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Public backend origin.
# Do not include /api at the end unless your code specifically requires it.
BACKEND_PUBLIC_URL=http://localhost:4000


# =========================================================
# Database
# =========================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=klinik_putrijaya
DB_CONNECTION_LIMIT=10

# Keep false for local MariaDB.
# Enable only when the production database provider requires TLS.
DB_SSL=false

# Optional CA certificate supplied by the database provider.
# Leave blank when DB_SSL=false.
DB_SSL_CA=


# =========================================================
# Authentication
# =========================================================

# Use a long, unique and random value in the real .env file.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h


# =========================================================
# Resend Email
# Used for transactional and internal notification emails.
# Leave these values blank to disable Resend email sending.
# =========================================================

RESEND_API_KEY=
RESEND_FROM=

# Global booking-alert recipients for every branch.
# Each list accepts one or more comma-separated addresses.
BOOKING_NOTIFICATION_EMAILS=monitor@example.com

# Additional recipients for bookings from the selected branch only.
BOOKING_NOTIFICATION_EMAILS_CHERAS=cheras@example.com
BOOKING_NOTIFICATION_EMAILS_SUNGAI_BESI=sgbesi@example.com
BOOKING_NOTIFICATION_EMAILS_PUCHONG=puchong@example.com


# =========================================================
# SMTP Email
# Used for admin verification and password reset emails.
# Leave the SMTP values blank to disable email sending.
# =========================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password

# Until a custom domain sender is verified, use the same email
# address configured under SMTP_USER.
MAIL_FROM="Klinik Putrijaya <your-email@gmail.com>"

# =========================================================
# Upload storage
# =========================================================

# Optional local or custom upload directory.
# Leave blank during normal local development.
UPLOAD_DIR=

# Railway automatically supplies RAILWAY_VOLUME_MOUNT_PATH
# after a persistent Volume is attached. Do not place a
# production mount path or secret inside this template.
